<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Sign in - PCI-DSS OTP MFA Research</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    <h1>Sign in</h1>
    <% if (error) { %><p role="alert" class="error"><%= error %></p><% } %>

    <form method="post" action="/login/otp/start">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required>

      <fieldset>
        <legend>Send code by</legend>
        <label><input type="radio" name="channel" value="email" checked> Email</label>
        <label><input type="radio" name="channel" value="sms"> SMS</label>
      </fieldset>

      <button type="submit">Send verification code</button>
    </form>
  </main>
</body>
</html>
