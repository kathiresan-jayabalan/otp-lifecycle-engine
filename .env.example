# Mailosaur - https://mailosaur.com (free trial covers both email and SMS servers)
MAILOSAUR_API_KEY=
MAILOSAUR_EMAIL_SERVER_ID=
MAILOSAUR_SMS_SERVER_ID=
# Copy the SMS-capable number assigned to your SMS server from the Mailosaur dashboard.
MAILOSAUR_SMS_NUMBER=

# demo-app
DEMO_APP_PORT=4000
DEMO_APP_SESSION_SECRET=change-me-for-real-deployments

# OTP policy parameters (seconds unless noted) - these feed control-profiles/*.yaml theta values
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=300
